# Copy to .env.local and fill in. Never commit real secrets.
# Values in <angle brackets> are placeholders: the app treats them (and empty values) as unset.
#
# Deploying on Vercel (step by step: docs/deploy.md): enter the values in Vercel → Project →
# Settings → Environment Variables, without the surrounding quotes. Never upload this file.
# Each variable is tagged:
#   [Vercel: required]     the deployment does not work without it
#   [Vercel: recommended]  has a default, but set a real value for the deployment
#   [Vercel: optional]     the default is fine; set it only to change the behaviour
#   [local only]           read by npm scripts on your machine; leave it out of Vercel
# Vercel sets NODE_ENV=production and VERCEL=1 itself. Never set VERCEL anywhere else: it makes the
# app trust the X-Forwarded-For / X-Forwarded-Host headers that only Vercel's edge sets reliably.
# Vercel applies variable changes to new deployments only: redeploy after editing one.

# Database
# Local: npm run db:start (or docker compose up -d). Atlas: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
# [Vercel: required] both. MONGODB_URI is the Atlas URI (Atlas Network Access must allow 0.0.0.0/0);
# MONGODB_DB has no default on Vercel: cit_prod for Production, cit_preview for Preview.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="cit_dev"                 # cit_prod on the deployed app (must be set explicitly on Vercel)
# Then load the bundled dataset and demo accounts: npm run seed (npm run seed -- --stored keeps the last upload)
# Deployed database, run from your machine (it resets that database; shell values beat .env.local):
#   MONGODB_URI="<atlas uri>" MONGODB_DB="cit_prod" npm run seed

# Auth
# [Vercel: required] a new random value per environment (never your local one). On Vercel a short,
# placeholder-looking or low-variety value fails every request; changing it signs everyone out.
AUTH_SECRET="<32+ random chars, e.g. openssl rand -base64 32>"

# AI (Gemini)
# [Vercel: optional] all five. Without a key the app uses its rule-based parsers and template text.
GEMINI_API_KEY="<your key>"
GEMINI_MODEL_FAST="gemini-3.8-flash"   # booking parser, assistant intents (default when unset: gemini-3.8-flash)
GEMINI_MODEL_SMART="gemini-3.8-flash"  # explanations and assistant replies (same default)
LLM_ENABLED="true"                   # false = rule-based parsers + template text (also off without a key)
LLM_TIMEOUT_MS="8000"                # keep far below Vercel's 60 s route limit

# Solver
# [Vercel: optional] both. Keep the budget at 8000 or less on Vercel (heavy routes stop at 60 s).
SOLVER_TIME_BUDGET_MS="8000"
SOLVER_SEED="42"

# App
TEAM_NAME="CIT Crunch Week"          # [Vercel: recommended] the registered team name; written to schedule.json
APP_URL="http://localhost:3000"      # [local only] base URL npm run export downloads from (or: npm run export -- --url <url>)
# EXPORT_EMAIL="" / EXPORT_PASSWORD=""  # [local only] optional admin account for npm run export (default: the demo admin)
APP_REFERENCE_DATE="2027-02-08"      # [Vercel: optional] the "today" that "kal"/"tomorrow" resolves against (Monday of fest week)

# Tooling [local only] (optional; set in your shell: validate and parity do not load .env.local)
# PYTHON="python3"                  # interpreter used by npm run validate
# TEST_MONGODB_URI="mongodb://127.0.0.1:27017"   # database server for the test suites (throwaway DBs)
# SOLVER_QUALITY="1"                # opt-in solver quality test (default budget, soft <= 10)

# Account auth (validated in src/lib/env.ts)
JWT_SECRET=""                        # [Vercel: optional] overrides AUTH_SECRET when set. 32+ random chars (placeholders rejected in production)
DEMO_LOGIN_ENABLED="true"            # [Vercel: optional] default true; keep it on: judges sign in with the demo accounts (POST /api/auth/demo-login)
# Club-rep sign-up codes are emailed through Brevo [Vercel: optional]; the key prefix picks the transport:
#   xsmtpsib-...  SMTP relay (nodemailer): also set BREVO_SMTP_LOGIN (shown next to the key in Brevo; BREVO_SMTP_USER is accepted as an alias)
#   xkeysib-...   REST API
# Without a key, development prints "[dev] OTP for <email>: <code>" in the server console;
# production (every Vercel deployment) answers 503 MAIL_UNAVAILABLE on sign-up (demo accounts still work).
# Codes never appear in responses.
BREVO_API_KEY="<your Brevo API or SMTP key>"
BREVO_SENDER_EMAIL="<sender@example.org>"  # required: a Brevo-verified sender; "Name <sender@example.org>" also works
BREVO_SENDER_NAME="CIT Nexus"
BREVO_SMTP_LOGIN="<your Brevo SMTP login>"  # required with an xsmtpsib- key
# BREVO_SMTP_USER=""                # alias of BREVO_SMTP_LOGIN
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"                # 465 switches to implicit TLS
# Google sign-in is not available yet: /api/auth/google redirects to /login?error=google_unavailable.
# Enabling it needs a callback route with state + PKCE first. [Vercel: optional] leave both unset.
GOOGLE_CLIENT_ID="<your Google OAuth client id>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # public base URL (absolute); reserved for the OAuth callback, unused today. Inlined at build time
