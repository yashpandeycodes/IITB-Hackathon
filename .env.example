# Copy to .env.local and fill in. Never commit real secrets.
# Values in <angle brackets> are placeholders: the app treats them (and empty values) as unset.

# Database
# Local: npm run db:start (or docker compose up -d). Atlas: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="cit_dev"                 # cit_prod on the deployed app

# Auth
AUTH_SECRET="<32+ random chars, e.g. openssl rand -base64 32>"

# AI (Gemini)
GEMINI_API_KEY="<your key>"
GEMINI_MODEL_FAST="<current stable Gemini Flash model id>"       # parsing, intents
GEMINI_MODEL_SMART="<current stable Gemini Pro/Flash model id>"  # assistant replies, explanations
LLM_ENABLED="true"                   # false = rule-based parser + manual form only
LLM_TIMEOUT_MS="8000"

# Solver
SOLVER_TIME_BUDGET_MS="8000"
SOLVER_SEED="42"

# App
TEAM_NAME="CIT Crunch Week"          # written to schedule.json
APP_REFERENCE_DATE="2027-02-08"      # the "today" that "kal"/"tomorrow" resolves against (Monday of fest week)

# Tooling (optional; set in your shell, scripts do not load .env.local)
# PYTHON="python3"                  # interpreter used by npm run validate

# Account auth merged from main (being consolidated onto the shared backend stack)
JWT_SECRET=""                        # optional; falls back to AUTH_SECRET. Must be 32+ chars if set
BREVO_API_KEY="<your Brevo API key>" # email OTP delivery; without it the OTP flow runs in demo mode
BREVO_SENDER_EMAIL="<sender@example.org>"
BREVO_SENDER_NAME="CIT Nexus"
GOOGLE_CLIENT_ID="<your Google OAuth client id>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # public base URL, used for OAuth redirects
