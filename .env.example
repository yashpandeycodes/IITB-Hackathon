# Copy to .env.local and fill in. Never commit real secrets.
# Values in <angle brackets> are placeholders: the app treats them (and empty values) as unset.

# Database
# Local: npm run db:start (or docker compose up -d). Atlas: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="cit_dev"                 # cit_prod on the deployed app (must be set explicitly on Vercel)
# Then load the bundled dataset and demo accounts: npm run seed (npm run seed -- --stored keeps the last upload)

# Auth
AUTH_SECRET="<32+ random chars, e.g. openssl rand -base64 32>"

# AI (Gemini)
GEMINI_API_KEY="<your key>"
GEMINI_MODEL_FAST="gemini-3.8-flash"   # booking parser (default when unset: gemini-3.8-flash)
GEMINI_MODEL_SMART="gemini-3.8-flash"  # booking explanations (same default)
LLM_ENABLED="true"                   # false = rule-based parser + template explanations (also off without a key)
LLM_TIMEOUT_MS="8000"

# Solver
SOLVER_TIME_BUDGET_MS="8000"
SOLVER_SEED="42"

# App
TEAM_NAME="CIT Crunch Week"          # written to schedule.json
APP_URL="http://localhost:3000"      # base URL npm run export downloads from (or: npm run export -- --url <url>)
# EXPORT_EMAIL="" / EXPORT_PASSWORD=""  # optional admin account for npm run export (default: the demo admin)
APP_REFERENCE_DATE="2027-02-08"      # the "today" that "kal"/"tomorrow" resolves against (Monday of fest week)

# Tooling (optional; set in your shell: validate and parity do not load .env.local)
# PYTHON="python3"                  # interpreter used by npm run validate
# TEST_MONGODB_URI="mongodb://127.0.0.1:27017"   # database server for the test suites (throwaway DBs)
# SOLVER_QUALITY="1"                # opt-in solver quality test (default budget, soft <= 10)

# Account auth (validated in src/lib/env.ts)
JWT_SECRET=""                        # optional; overrides AUTH_SECRET when set. 32+ random chars (placeholders rejected in production)
DEMO_LOGIN_ENABLED="true"            # one-click demo-account sign-in (POST /api/auth/demo-login); judges need it on the deployment
# Club-rep sign-up codes are emailed through Brevo; the key prefix picks the transport:
#   xsmtpsib-...  SMTP relay (nodemailer): also set BREVO_SMTP_LOGIN (shown next to the key in Brevo; BREVO_SMTP_USER is accepted as an alias)
#   xkeysib-...   REST API
# Without a key, development prints "[dev] OTP for <email>: <code>" in the server console;
# production answers 503 MAIL_UNAVAILABLE (demo accounts still work). Codes never appear in responses.
BREVO_API_KEY="<your Brevo API or SMTP key>"
BREVO_SENDER_EMAIL="<sender@example.org>"  # required: a Brevo-verified sender; "Name <sender@example.org>" also works
BREVO_SENDER_NAME="CIT Nexus"
BREVO_SMTP_LOGIN="<your Brevo SMTP login>"  # required with an xsmtpsib- key
# BREVO_SMTP_USER=""                # alias of BREVO_SMTP_LOGIN
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"                # 465 switches to implicit TLS
# Google sign-in is not available yet: /api/auth/google redirects to /login?error=google_unavailable.
# Enabling it needs a callback route with state + PKCE first.
GOOGLE_CLIENT_ID="<your Google OAuth client id>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # public base URL (absolute); reserved for the OAuth callback, unused today
