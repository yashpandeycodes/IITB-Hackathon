# Copy to .env.local and fill in. Never commit real secrets.
# Values in <angle brackets> are placeholders: the app treats them (and empty values) as unset.

# Database
# Local: npm run db:start (or docker compose up -d). Atlas: mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="cit_dev"                 # cit_prod on the deployed app (must be set explicitly on Vercel)
# Then load the bundled dataset and demo accounts: npm run seed (npm run seed -- --stored keeps the last upload)

# Auth
AUTH_SECRET="<32+ random chars, e.g. openssl rand -base64 32>"

# AI (Gemini)
GEMINI_API_KEY="<your key>"
GEMINI_MODEL_FAST="<current stable Gemini Flash model id>"       # parsing, intents
GEMINI_MODEL_SMART="<current stable Gemini Pro/Flash model id>"  # assistant replies, explanations
LLM_ENABLED="true"                   # false = rule-based parser + manual form only
LLM_TIMEOUT_MS="8000"

# Solver
SOLVER_TIME_BUDGET_MS="8000"
SOLVER_SEED="42"

# App
TEAM_NAME="CIT Crunch Week"          # written to schedule.json
APP_REFERENCE_DATE="2027-02-08"      # the "today" that "kal"/"tomorrow" resolves against (Monday of fest week)

# Tooling (optional; set in your shell: validate and parity do not load .env.local)
# PYTHON="python3"                  # interpreter used by npm run validate
# TEST_MONGODB_URI="mongodb://127.0.0.1:27017"   # database server for the test suites (throwaway DBs)

# Account auth (validated in src/lib/env.ts)
JWT_SECRET=""                        # optional; overrides AUTH_SECRET when set. 32+ random chars (placeholders rejected in production)
DEMO_LOGIN_ENABLED="true"            # one-click demo-account sign-in (POST /api/auth/demo-login); judges need it on the deployment
# Club-rep sign-up codes are emailed through Brevo. Without a key, development returns the code in
# the response (demoOtp) and production answers 503 MAIL_UNAVAILABLE (demo accounts still work).
BREVO_API_KEY="<your Brevo API key>"
BREVO_SENDER_EMAIL="<sender@example.org>"  # required for real mail: a sender verified in Brevo
BREVO_SENDER_NAME="CIT Nexus"
# Google sign-in is not available yet: /api/auth/google redirects to /login?error=google_unavailable.
# Enabling it needs a callback route with state + PKCE first.
GOOGLE_CLIENT_ID="<your Google OAuth client id>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # public base URL (absolute); reserved for the OAuth callback, unused today
